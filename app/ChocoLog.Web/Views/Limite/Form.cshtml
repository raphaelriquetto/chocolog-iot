@model LimiteViewModel
@{
    ViewData["Title"] = "Limites";
}

<h2>Limites de Conservação</h2>
<p class="text-muted">
    O monitor compara a <strong>média</strong> das últimas medidas com estes limites a cada 10 s.
    Ficam guardados no Orion (entidade <code>@LimiteDAO.IdEntidade</code>).
</p>
@if (!Model.SalvoNoOrion)
{
    <div class="alert alert-warning">Ainda não salvos no Orion: valem os valores do <code>chocolog.ino</code>. Clique em Salvar dados para criar.</div>
}

<div class="row g-4">
    <div class="col-lg-6">
        <form asp-action="Save" method="post" class="card card-body shadow-sm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-6">
                    <label for="TempMin" class="form-label">Temperatura mínima (°C)</label>
                    <input asp-for="TempMin" type="text" class="form-control" />
                    <span asp-validation-for="TempMin" class="text-danger"></span>
                </div>
                <div class="col-6">
                    <label for="TempMax" class="form-label">Temperatura máxima (°C)</label>
                    <input asp-for="TempMax" type="text" class="form-control" />
                    <span asp-validation-for="TempMax" class="text-danger"></span>
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-6">
                    <label for="UmidMin" class="form-label">Umidade mínima (%)</label>
                    <input asp-for="UmidMin" type="text" class="form-control" />
                    <span asp-validation-for="UmidMin" class="text-danger"></span>
                </div>
                <div class="col-6">
                    <label for="UmidMax" class="form-label">Umidade máxima (%)</label>
                    <input asp-for="UmidMax" type="text" class="form-control" />
                    <span asp-validation-for="UmidMax" class="text-danger"></span>
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-6">
                    <label for="LuzMax" class="form-label">Luminosidade máxima (%)</label>
                    <input asp-for="LuzMax" type="text" class="form-control" />
                    <span asp-validation-for="LuzMax" class="text-danger"></span>
                </div>
                <div class="col-6">
                    <label for="Janela" class="form-label">Janela da média (medidas)</label>
                    <input asp-for="Janela" class="form-control" />
                    <span asp-validation-for="Janela" class="text-danger"></span>
                    <div class="form-text">12 medidas × 5 s = média do último minuto.</div>
                </div>
            </div>
            <br />

            <div>
                <input type="submit" value="Salvar dados" class="btn btn-success" />
                @if (Model.SalvoNoOrion)
                {
                    <a href="javascript:restaurarLimites()" class="btn btn-light">Restaurar padrão</a>
                }
            </div>
        </form>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">O que o ESP32 faz em cada alerta</div>
            <table class="table mb-0">
                <tr class="table-dark"><th>Prioridade</th><th>Condição (média)</th><th>LED azul</th><th>Buzzer</th></tr>
                <tr><td>1</td><td>Temperatura fora de @Model.TempMin a @Model.TempMax °C</td><td>4 piscadas/s</td><td>2500 Hz</td></tr>
                <tr><td>2</td><td>Umidade fora de @Model.UmidMin a @Model.UmidMax %</td><td>2 piscadas/s</td><td>1200 Hz</td></tr>
                <tr><td>3</td><td>Luminosidade acima de @Model.LuzMax %</td><td>1 piscada/s</td><td>600 Hz</td></tr>
                <tr><td>-</td><td>Tudo dentro dos limites</td><td>apagado</td><td>mudo</td></tr>
            </table>
        </div>
    </div>
</div>
