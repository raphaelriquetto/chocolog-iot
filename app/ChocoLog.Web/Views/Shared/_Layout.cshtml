<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "ChocoLog") - ChocoLog</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", false)
</head>
<body class="area-admin">
    <nav class="navbar navbar-expand-lg navbar-dark navbar-admin sticky-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand logo" asp-controller="Home" asp-action="Index">🍫 Choco<span>Log</span> <small class="badge bg-secondary">IoT</small></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuAdmin">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menuAdmin">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Cadastros</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Carga" asp-action="Index">Cargas</a></li>
                            <li><a class="dropdown-item" asp-controller="Dispositivo" asp-action="Index">Dispositivos</a></li>
                            <li><a class="dropdown-item" asp-controller="Limite" asp-action="Index">Limites</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Consultas</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Mensagem" asp-action="ConsultaMensagens">Mensagens IoT</a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="/swagger" target="_blank">APIs (Swagger)</a></li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item"><span class="nav-link text-light small">FIWARE: @ConexaoFiware.Atual.Host</span></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Configuracao" asp-action="Index">Configuração</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container-fluid px-4 py-4">
        <partial name="_Mensagens" />
        @RenderBody()
    </main>

    <footer class="rodape">
        <div class="container-fluid px-4">ChocoLog IoT · Sistemas Embarcados e Linguagem de Programação I · FESA</div>
    </footer>

    <div id="toast" class="toast-loja"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
