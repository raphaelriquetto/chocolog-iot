@model ConfiguracaoViewModel
@{
    ViewData["Title"] = "Configuração";
    var etapas = (List<KeyValuePair<string, bool>>)ViewBag.Etapas;
    var assinaturas = (List<AssinaturaViewModel>)ViewBag.Assinaturas;
}

<h2>Configuração</h2>

<div class="row g-4">
    <div class="col-lg-6">
        <form asp-action="Save" method="post" class="card card-body shadow-sm h-100">
            <h5>Servidor FIWARE</h5>
            <p class="text-muted small">O IP público do Learner Lab muda a cada início da sessão: troque aqui, sem reiniciar a aplicação.</p>

            <label for="Host" class="form-label">Servidor (IP público da EC2)</label>
            <input asp-for="Host" class="form-control" placeholder="54.123.45.67" />
            <span asp-validation-for="Host" class="text-danger"></span>
            <br />

            <div class="row">
                <div class="col-4">
                    <label for="OrionPort" class="form-label small">Porta do Orion</label>
                    <input asp-for="OrionPort" class="form-control" />
                </div>
                <div class="col-4">
                    <label for="IotAgentPort" class="form-label small">Porta do IoT Agent</label>
                    <input asp-for="IotAgentPort" class="form-control" />
                </div>
                <div class="col-4">
                    <label for="SthPort" class="form-label small">Porta do STH-Comet</label>
                    <input asp-for="SthPort" class="form-control" />
                </div>
            </div>
            <span asp-validation-for="OrionPort" class="text-danger"></span>
            <br />

            <details class="mb-3">
                <summary class="small text-muted">Identificadores (só mude se mudar no firmware também)</summary>
                <div class="row g-2 mt-1">
                    <div class="col-6"><label class="form-label small" for="Service">fiware-service</label><input asp-for="Service" class="form-control" /><span asp-validation-for="Service" class="text-danger"></span></div>
                    <div class="col-6"><label class="form-label small" for="ServicePath">fiware-servicepath</label><input asp-for="ServicePath" class="form-control" /><span asp-validation-for="ServicePath" class="text-danger"></span></div>
                    <div class="col-6"><label class="form-label small" for="ApiKey">API key</label><input asp-for="ApiKey" class="form-control" /><span asp-validation-for="ApiKey" class="text-danger"></span></div>
                    <div class="col-6"><label class="form-label small" for="DispositivoMonitorado">Device do dashboard</label><input asp-for="DispositivoMonitorado" class="form-control" /><span asp-validation-for="DispositivoMonitorado" class="text-danger"></span></div>
                </div>
            </details>

            <div>
                <input type="submit" value="Salvar dados" class="btn btn-success" />
                <input type="button" value="Testar conexão" class="btn btn-outline-dark" onclick="testaConexao()" />
            </div>
        </form>
    </div>

    <div class="col-lg-6">
        <div class="card card-body shadow-sm h-100">
            <h5>Provisionamento</h5>
            <p class="text-muted small">Cria no FIWARE o que falta para o ESP32 funcionar. Pode clicar de novo: o que já existe é pulado.</p>
            <ul class="list-unstyled">
                @foreach (var etapa in etapas)
                {
                    <li class="mb-2">
                        @if (etapa.Value)
                        {
                            <span class="badge bg-success">ok</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">pendente</span>
                        }
                        @etapa.Key
                    </li>
                }
                @if (etapas.Count == 0)
                {
                    <li class="text-muted">Sem resposta do FIWARE. Confira o servidor ao lado.</li>
                }
            </ul>
            <form asp-action="Provisionar" method="post">
                <input type="submit" value="Provisionar tudo" class="btn btn-primary" />
            </form>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-4 mb-2">
    <h4 class="mb-0">Assinaturas no Orion</h4>
    <a href="/configuracao/CriaAssinatura" class="btn btn-sm btn-primary">+ Assinatura do histórico</a>
</div>
<table class="table table-hover align-middle bg-white shadow-sm">
    <tr class="table-dark">
        <th style="width: 100px">Ações</th>
        <th>Descrição</th>
        <th>Atributos</th>
        <th>Destino</th>
        <th>Situação</th>
        <th>Última notificação</th>
    </tr>
    @foreach (var a in assinaturas)
    {
        <tr>
            <td><a href="javascript:apagarAssinatura('@a.Id')" class="btn btn-sm btn-danger">Apagar</a></td>
            <td>@a.Descricao<div class="small text-muted">@a.Id</div></td>
            <td class="small">@string.Join(", ", a.Atributos)</td>
            <td class="small">@a.Url</td>
            <td><span class="badge @(a.Situacao == "active" ? "bg-success" : "bg-secondary")">@a.Situacao</span></td>
            <td class="small">@(a.UltimaNotificacao == null ? "-" : DateTime.Parse(a.UltimaNotificacao).ToString("dd/MM HH:mm:ss"))</td>
        </tr>
    }
    @if (assinaturas.Count == 0)
    {
        <tr><td colspan="6" class="text-center text-muted py-4">Nenhuma assinatura. Sem ela o STH-Comet não recebe as medidas.</td></tr>
    }
</table>
