@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-end mb-2">
    <h2 class="mb-0">Dashboard</h2>
    <span class="text-muted small" id="atualizadoEm">Carregando...</span>
</div>
<p class="text-muted">Valores do ESP32 carregados via AJAX a cada 5 segundos, a partir das APIs do dashboard.</p>

<div id="faixaAlerta" class="faixa-alerta aguardando mb-4">
    <div class="titulo" id="alertaTitulo">Aguardando dados</div>
    <div class="detalhe" id="alertaDetalhe">O monitor calcula as médias a cada 10 segundos.</div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card card-resumo" id="cardTemperatura"><div class="card-body"><small>Temperatura</small><h3 id="valTemperatura">...</h3><div class="small text-muted" id="medTemperatura"></div></div></div></div>
    <div class="col-md-4"><div class="card card-resumo" id="cardUmidade"><div class="card-body"><small>Umidade</small><h3 id="valUmidade">...</h3><div class="small text-muted" id="medUmidade"></div></div></div></div>
    <div class="col-md-4"><div class="card card-resumo" id="cardLuminosidade"><div class="card-body"><small>Luminosidade</small><h3 id="valLuminosidade">...</h3><div class="small text-muted" id="medLuminosidade"></div></div></div></div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-bold">Temperatura (°C)</div>
            <div class="card-body"><div class="area-grafico"><canvas id="graficoTemperatura"></canvas></div></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-bold">Umidade (%)</div>
            <div class="card-body"><div class="area-grafico"><canvas id="graficoUmidade"></canvas></div></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-bold">Luminosidade (%)</div>
            <div class="card-body"><div class="area-grafico"><canvas id="graficoLuminosidade"></canvas></div></div>
        </div>
    </div>
</div>

<div class="row g-3 mt-2">
    <div class="col-md-3"><a class="btn btn-outline-dark w-100" href="/mensagem/ConsultaMensagens">Consultar mensagens</a></div>
    <div class="col-md-3"><a class="btn btn-outline-dark w-100" href="/carga/index">Gerenciar cargas</a></div>
    <div class="col-md-3"><a class="btn btn-outline-dark w-100" href="/limite/index">Ajustar limites</a></div>
    <div class="col-md-3"><a class="btn btn-outline-dark w-100" href="/configuracao/index">Configuração</a></div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        carregaDashboard();
        setInterval(carregaDashboard, 5000);
    </script>
}
