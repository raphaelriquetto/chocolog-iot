@model DispositivoViewModel
@{
    ViewData["Title"] = "Cadastro de device";
}

<h2>Cadastro de Device</h2>
<p class="text-muted">
    O device é criado no IoT Agent com os atributos <code>t</code> (temperatura), <code>h</code> (umidade),
    <code>l</code> (luminosidade), <code>a</code> (alerta) e o comando <code>alert</code>, via MQTT.
    O código 1 vira o device <code>choco001</code>, o mesmo nome gravado no firmware.
</p>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Save" method="post" class="card card-body shadow-sm">
            <input type="hidden" name="Operacao" value="@ViewBag.Operacao" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <label for="Id" class="form-label">Código</label>
            @if (ViewBag.Operacao == "I")
            {
                <input asp-for="Id" class="form-control" />
            }
            else
            {
                <input asp-for="Id" class="form-control" readonly />
            }
            <span asp-validation-for="Id" class="text-danger"></span>
            <br />

            <label for="Descricao" class="form-label">Descrição</label>
            <input asp-for="Descricao" class="form-control" maxlength="80" placeholder="ChocoLog do caminhão refrigerado" />
            <span asp-validation-for="Descricao" class="text-danger"></span>
            <br />

            <label for="Local" class="form-label">Local</label>
            <input asp-for="Local" class="form-control" maxlength="80" placeholder="Caminhão 1" />
            <span asp-validation-for="Local" class="text-danger"></span>
            <br />

            <div>
                <input type="submit" value="Salvar dados" class="btn btn-success" />
                <a href="/dispositivo/index" class="btn btn-light">Voltar</a>
            </div>
        </form>
    </div>
</div>
