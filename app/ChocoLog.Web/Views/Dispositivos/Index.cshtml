@model List<DeviceInfo>
@{
    ViewData["Title"] = "Dispositivos";
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="page-title h3 mb-0">Dispositivos</h1>
        <div class="text-muted small">Devices provisionados no IoT Agent. Cada um vira uma entidade no Orion.</div>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Novo device</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Device</th><th>Entidade no Orion</th><th>Descrição / local</th><th>Atributos (MQTT → Orion)</th><th>Comandos</th><th class="text-end">Ações</th></tr></thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">Nenhum device. Use "Novo device" ou o provisionamento em Configuração.</td></tr>
            }
            @foreach (var d in Model)
            {
                <tr>
                    <td class="fw-semibold">@d.DeviceId <div class="small text-muted">@d.Transport</div></td>
                    <td class="small">@d.EntityId</td>
                    <td>@d.Description <div class="small text-muted">@d.Location</div></td>
                    <td class="small">@string.Join(" · ", d.Attributes)</td>
                    <td class="small">@string.Join(", ", d.Commands)</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@d.DeviceId" aria-label="Editar @d.DeviceId"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@d.DeviceId" method="post" class="d-inline"
                              onsubmit="return confirm('Remover o device @d.DeviceId do IoT Agent e a entidade dele no Orion?')">
                            <input type="hidden" name="entityId" value="@d.EntityId" />
                            <input type="hidden" name="apagarEntidade" value="true" />
                            <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Remover @d.DeviceId"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
