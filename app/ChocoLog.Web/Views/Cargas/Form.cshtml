@model Carga
@{
    bool editing = ViewBag.Editing == true;
    ViewData["Title"] = editing ? "Editar carga" : "Nova carga";
    var devices = (List<DeviceInfo>)(ViewBag.Devices ?? new List<DeviceInfo>());
}
<h1 class="page-title h3 mb-3">@ViewData["Title"]</h1>

<form method="post" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Code : null)" class="card card-body" style="max-width: 760px">
    @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>
    }
    <div class="row g-3">
        <div class="col-sm-4">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" placeholder="CARGA-001" disabled="@editing" />
            <span asp-validation-for="Code" class="text-danger small"></span>
        </div>
        <div class="col-sm-8">
            <label asp-for="Product" class="form-label"></label>
            <input asp-for="Product" class="form-control" placeholder="Barra ao leite 90 g" />
            <span asp-validation-for="Product" class="text-danger small"></span>
        </div>
        <div class="col-sm-4">
            <label asp-for="Boxes" class="form-label"></label>
            <input asp-for="Boxes" class="form-control" type="number" min="1" />
            <span asp-validation-for="Boxes" class="text-danger small"></span>
        </div>
        <div class="col-sm-4">
            <label asp-for="Origin" class="form-label"></label>
            <input asp-for="Origin" class="form-control" placeholder="São Bernardo do Campo" />
            <span asp-validation-for="Origin" class="text-danger small"></span>
        </div>
        <div class="col-sm-4">
            <label asp-for="Destination" class="form-label"></label>
            <input asp-for="Destination" class="form-control" placeholder="Buenos Aires" />
            <span asp-validation-for="Destination" class="text-danger small"></span>
        </div>
        <div class="col-sm-4">
            <label asp-for="Departure" class="form-label"></label>
            <input asp-for="Departure" class="form-control" type="date" />
            <span asp-validation-for="Departure" class="text-danger small"></span>
        </div>
        <div class="col-sm-4">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select" asp-items="@(new SelectList(Carga.StatusList))"></select>
            <span asp-validation-for="Status" class="text-danger small"></span>
        </div>
        <div class="col-sm-4">
            <label asp-for="DeviceEntityId" class="form-label"></label>
            <select asp-for="DeviceEntityId" class="form-select">
                <option value="">Escolha…</option>
                @foreach (var d in devices)
                {
                    <option value="@d.EntityId" selected="@(d.EntityId == Model.DeviceEntityId)">@d.DeviceId · @d.Location</option>
                }
            </select>
            @if (devices.Count == 0)
            {
                <div class="form-text">Nenhum device provisionado. Cadastre em Dispositivos.</div>
            }
            <span asp-validation-for="DeviceEntityId" class="text-danger small"></span>
        </div>
    </div>
    <div class="d-flex gap-2 mt-4">
        <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg"></i> Salvar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>
