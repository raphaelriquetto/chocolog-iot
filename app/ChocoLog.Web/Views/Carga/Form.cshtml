@model CargaViewModel
@{
    ViewData["Title"] = "Cadastro de carga";
}

<h2>Cadastro de Carga</h2>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Save" method="post" class="card card-body shadow-sm">
            <input type="hidden" name="Operacao" value="@ViewBag.Operacao" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-3">
                    <label for="Id" class="form-label">Código</label>
                    @if (ViewBag.Operacao == "I")
                    {
                        <input asp-for="Id" class="form-control" />
                    }
                    else
                    {
                        <input asp-for="Id" class="form-control" readonly />
                    }
                    <span asp-validation-for="Id" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label for="Produto" class="form-label">Produto</label>
                    <input asp-for="Produto" class="form-control" maxlength="60" placeholder="Barra ao leite 90 g" />
                    <span asp-validation-for="Produto" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label for="Caixas" class="form-label">Caixas</label>
                    <input asp-for="Caixas" class="form-control" />
                    <span asp-validation-for="Caixas" class="text-danger"></span>
                </div>
            </div>
            <br />

            <div class="row">
                <div class="col-md-6">
                    <label for="Origem" class="form-label">Origem</label>
                    <input asp-for="Origem" class="form-control" maxlength="60" placeholder="São Bernardo do Campo" />
                    <span asp-validation-for="Origem" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label for="Destino" class="form-label">Destino</label>
                    <input asp-for="Destino" class="form-control" maxlength="60" placeholder="Buenos Aires" />
                    <span asp-validation-for="Destino" class="text-danger"></span>
                </div>
            </div>
            <br />

            <div class="row">
                <div class="col-md-4">
                    <label for="DataSaida" class="form-label">Data de saída</label>
                    <input asp-for="DataSaida" type="date" class="form-control" value="@Model.DataSaida.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="DataSaida" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label for="Situacao" class="form-label">Situação</label>
                    <select asp-for="Situacao" asp-items="ViewBag.Situacoes" class="form-select"></select>
                    <span asp-validation-for="Situacao" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label for="DispositivoId" class="form-label">Monitorada pelo device</label>
                    <select asp-for="DispositivoId" asp-items="ViewBag.Dispositivos" class="form-select"></select>
                    <span asp-validation-for="DispositivoId" class="text-danger"></span>
                </div>
            </div>
            <br />

            <div>
                <input type="submit" value="Salvar dados" class="btn btn-success" />
                <a href="/carga/index" class="btn btn-light">Voltar</a>
            </div>
        </form>
    </div>
</div>
